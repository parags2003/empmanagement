@model EmployeeLeaveManagement.ViewModels.LeaveRequestViewModel
@{
    ViewData["Title"] = "Apply Leave";
}

<div class="space-y-6 max-w-5xl">
    <div class="flex items-center gap-4">
        <a asp-action="List" class="p-2 border rounded-lg hover:bg-gray-100">
            <i class="fa fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Apply for Leave</h1>
            <p class="text-gray-500 text-sm mt-1">Submit a leave request</p>
        </div>
    </div>

    <form asp-action="Apply" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

        <div class="bg-white shadow-md rounded-xl border p-6 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="EmployeeId" class="block text-sm font-medium">Employee *</label>
                    <select asp-for="EmployeeId" class="mt-1 w-full border rounded-lg p-2" asp-items="@(new SelectList(Model.Employees, nameof(EmployeeLeaveManagement.ViewModels.EmployeeDropdownViewModel.EmployeeId), nameof(EmployeeLeaveManagement.ViewModels.EmployeeDropdownViewModel.Name)))">
                        <option value="">-- Select Employee --</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="LeaveTypeId" class="block text-sm font-medium">Leave Type *</label>
                    <select asp-for="LeaveTypeId" class="mt-1 w-full border rounded-lg p-2" asp-items="@(new SelectList(Model.LeaveTypes, nameof(EmployeeLeaveManagement.ViewModels.LeaveTypeDropdownViewModel.LeaveTypeId), nameof(EmployeeLeaveManagement.ViewModels.LeaveTypeDropdownViewModel.LeaveName)))">
                        <option value="">-- Select Leave Type --</option>
                    </select>
                    <span asp-validation-for="LeaveTypeId" class="text-red-600 text-sm"></span>
                    <p class="text-xs text-gray-500 mt-1">Available days: <span id="availableDays">@Model.AvailableDays</span></p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StartDate" class="block text-sm font-medium">Start Date *</label>
                    <input asp-for="StartDate" type="date" class="mt-1 w-full border rounded-lg p-2" />
                    <span asp-validation-for="StartDate" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label asp-for="EndDate" class="block text-sm font-medium">End Date *</label>
                    <input asp-for="EndDate" type="date" class="mt-1 w-full border rounded-lg p-2" />
                    <span asp-validation-for="EndDate" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div>
                <label asp-for="Reason" class="block text-sm font-medium">Reason *</label>
                <textarea asp-for="Reason" rows="4" class="mt-1 w-full border rounded-lg p-3"></textarea>
                <span asp-validation-for="Reason" class="text-red-600 text-sm"></span>
            </div>

            <div class="flex gap-3 pt-4">
                <button type="submit" class="flex-1 bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700">
                    Submit Request
                </button>
                <a asp-action="List" class="flex-1 border py-2 text-center rounded-lg hover:bg-gray-100">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const employeeSelect = document.getElementById('EmployeeId');
            const leaveTypeSelect = document.getElementById('LeaveTypeId');
            const availableDaysLabel = document.getElementById('availableDays');
            const endpoint = '@Url.Action("GetAvailableDays", "Leave")';

            async function fetchAvailableDays() {
                const employeeId = employeeSelect.value;
                const leaveTypeId = leaveTypeSelect.value;

                if (!employeeId || !leaveTypeId) {
                    availableDaysLabel.textContent = '0';
                    return;
                }

                try {
                    const response = await fetch(`${endpoint}?employeeId=${employeeId}&leaveTypeId=${leaveTypeId}`);
                    const data = await response.json();
                    availableDaysLabel.textContent = data.remainingDays ?? 0;
                } catch (error) {
                    availableDaysLabel.textContent = '0';
                }
            }

            employeeSelect?.addEventListener('change', fetchAvailableDays);
            leaveTypeSelect?.addEventListener('change', fetchAvailableDays);
            fetchAvailableDays();
        });
    </script>
}

