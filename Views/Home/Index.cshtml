@model EmployeeLeaveManagement.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6">
    <!-- Header -->
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Dashboard</h1>
        <p class="text-gray-500 mt-1">Welcome back! Here's your employee overview.</p>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <!-- Total Employees -->
        <div class="bg-white shadow rounded-xl p-5 border">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Total Employees</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.TotalEmployees</p>
                    <p class="text-xs text-green-600 mt-1">+12% from last month</p>
                </div>
                <div class="p-3 bg-blue-100 rounded-full">
                    <i class="fa fa-users text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Active Employees -->
        <div class="bg-white shadow rounded-xl p-5 border">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Active Employees</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.ActiveEmployees</p>
                    <p class="text-xs text-green-600 mt-1">+5% from last month</p>
                </div>
                <div class="p-3 bg-green-100 rounded-full">
                    <i class="fa fa-user-check text-green-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- On Leave -->
        <div class="bg-white shadow rounded-xl p-5 border">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">On Leave</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.OnLeave</p>
                    <p class="text-xs text-red-600 mt-1">2 fewer than last week</p>
                </div>
                <div class="p-3 bg-red-100 rounded-full">
                    <i class="fa fa-user-times text-red-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- New Hires -->
        <div class="bg-white shadow rounded-xl p-5 border">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">New Hires</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.NewHires</p>
                    <p class="text-xs text-green-600 mt-1">+3 this month</p>
                </div>
                <div class="p-3 bg-purple-100 rounded-full">
                    <i class="fa fa-chart-line text-purple-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Employees Table -->
    <div class="bg-white shadow rounded-xl border">
        <div class="p-5 border-b">
            <h2 class="text-xl font-bold">Recently Added Employees</h2>
            <p class="text-gray-500">Your newest team members</p>
        </div>
        <div class="p-5 overflow-x-auto">
            <table class="min-w-full text-left">
                <thead>
                    <tr class="border-b">
                        <th class="py-3 px-4 text-sm text-gray-500">Name</th>
                        <th class="py-3 px-4 text-sm text-gray-500">Position</th>
                        <th class="py-3 px-4 text-sm text-gray-500">Department</th>
                        <th class="py-3 px-4 text-sm text-gray-500">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentEmployees != null && Model.RecentEmployees.Any())
                    {
                        @foreach (var emp in Model.RecentEmployees)
                        {
                            <tr class="border-b hover:bg-gray-50">
                                <td class="py-3 px-4 font-medium text-gray-900">@emp.Name</td>
                                <td class="py-3 px-4 text-gray-600">@emp.Position</td>
                                <td class="py-3 px-4 text-gray-600">@emp.Department</td>
                                <td class="py-3 px-4">
                                    <span class="px-3 py-1 rounded-full text-xs bg-green-100 text-green-700">
                                        @emp.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="py-3 px-4 text-center text-gray-500">No recent employees found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

