@model EmployeeLeaveManagement.ViewModels.EmployeeViewModel
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="space-y-6 max-w-3xl">
    <div class="flex items-center gap-4">
        <a asp-controller="Employee" asp-action="Index" class="p-2 border rounded-lg hover:bg-gray-100">
            <i class="fa fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-red-600">Delete Employee</h1>
            <p class="text-gray-500 text-sm mt-1">Are you sure you want to delete @Model.Name?</p>
        </div>
    </div>

    <div class="bg-white shadow rounded-xl border p-6 space-y-4">
        <p class="text-gray-700">This action cannot be undone.</p>

        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <dt class="text-sm text-gray-500">Employee Code</dt>
                <dd class="text-lg font-semibold">@Model.EmpCode</dd>
            </div>
            <div>
                <dt class="text-sm text-gray-500">Email</dt>
                <dd class="text-lg font-semibold">@Model.Email</dd>
            </div>
            <div>
                <dt class="text-sm text-gray-500">Department</dt>
                <dd class="text-lg font-semibold">@Model.Department</dd>
            </div>
            <div>
                <dt class="text-sm text-gray-500">Position</dt>
                <dd class="text-lg font-semibold">@Model.Position</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="EmployeeId" />
            <div class="flex gap-3 pt-4">
                <button type="submit" class="flex-1 bg-red-600 text-white py-2 rounded-lg hover:bg-red-700">
                    Delete
                </button>
                <a asp-controller="Employee" asp-action="Index" class="flex-1 border py-2 text-center rounded-lg hover:bg-gray-100">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

